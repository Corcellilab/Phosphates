 variable a index minimized
 log log.$a

#########################

 include "../../system.in.init"

 read_data "../../system.data"

 include "../../system.in.settings"

##################

 group wat type 1
 group wat include molecule
 group solute subtract all wat

 delete_atoms overlap 1.0 wat solute mol yes
 delete_atoms overlap 1.0 wat wat mol yes

##### Min ########
 min_style cg   #Conjugate gradient minimization
 minimize 1.0e-5 1.0e-7 2500 10000
 min_style sd   #Steepest gradient minimization
 minimize 1.0e-5 1.0e-7 4500 10000
 min_style cg
 minimize 1.0e-5 1.0e-7 4000 10000

 reset_atoms id sort yes

 write_data $a.data

